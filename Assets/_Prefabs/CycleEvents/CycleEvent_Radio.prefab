  data: {fileID: 11400000, guid: 220a7d00a1b583240b91a89a29c108ca, type: 2}
  subtitles:
  - strs:
    - "12\uC2DC\uC5D0 \uD575\uC774 \uD130\uC9C4\uB300\uC694"
    - "\uC608?"
    - "12\uC2DC\uC5D0 \uD575\uC774 \uD130\uC9C4\uB2E4\uACE0\uC694"
    - "\uC608????"
  - strs:
    - "\uACE0\uC591\uC774\uB294 \uADC0\uC5EC\uC6CC"
  - strs:
    - "\uD654\uC774\uD2B8\uBCF4\uB4DC\uC5D0 \uBCC4\uC744 \uADF8\uB9AC\uBA74"
    - "\uC2E0\uC774 \uD575\uC744 \uB9C9\uC544\uC900\uB2E4\uB294 \uC774\uC57C\uAE30\uAC00
      \uC788\uB2E4"
    - "\uB098\uB294 \uC774 \uC774\uC57C\uAE30\uB97C \uB9E4\uC6B0 \uC88B\uC544\uD55C\uB2E4"
  - strs:
    - "\uBC16\uC5D0 \uACF0\uC774 \uC788\uB2E4\uBA74"
    - "\uD018\uC2A4\uD2B8 \uC606\uC5D0 \uC788\uB294 \uCD1D\uC744 \uBC1C\uC0AC\uD558\uC138\uC694"
    - "\uC138 \uBC88 \uCD1D\uC5D0 \uB9DE\uC740 \uACF0\uC740 \uADF8 \uC790\uB9AC\uC5D0\uC11C
      \uC8FD\uC2B5\uB2C8\uB2E4"
  - strs:
    - "\uD14C\uB77C\uC2A4\uC5D0 \uC788\uB294 \uB3D9\uADF8\uB780 \uBC14\uB2E5\uC5D0
      \uC0C1\uD638\uC791\uC6A9\uD558\uC5EC"
    - "\uB2E4\uB978 \uBC29\uC73C\uB85C \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    - "\uACC4\uB2E8\uC744 \uC62C\uB77C\uAC00\uBA74 \uB610 \uB2E4\uB978 \uBC29\uC73C\uB85C
      \uC774\uC5B4\uC9D1\uB2C8\uB2E4."
  - strs:
    - "\uBC25\uC744 \uBA39\uC5C8\uC73C\uBA74"
    - "\uC124\uAC70\uC9C0\uB294 \uD574\uC57C\uC9C0!"
  - strs:
    - "\uC4F0\uB808\uAE30\uB294 \uC4F0\uB808\uAE30\uD1B5\uC5D0 \uBC84\uB824\uC57C\uC9C0"
  - strs:
    - "\uB450 \uBC88\uC9F8 \uBC29\uC5D0 \uC788\uB294 TV\uB97C \uCF1C\uBA74"
    - "\uC57C\uB3D9\uC774 \uB098\uC640\uC694"
    - "???: \uB124???"
  - strs:
    - "\uC790\uD310\uAE30\uC5D0 \uB3D9\uC804\uC744 \uB123\uC73C\uBA74"
    - "\uBB54\uAC00 \uB098\uC640\uC694"
  - strs:
    - "\uC637\uAC78\uC774\uC5D0 \uAC78\uB9B0 \uC637\uC73C\uB85C \uAC08\uC544\uC785\uC5B4\uC694"
    - "\uC0C8 \uC0AC\uB78C\uC774 \uB420 \uC218 \uC788\uC5B4\uC694"
  - strs:
    - "\uC0CC\uB4DC\uBC31\uC744 \uD1B5\uD574 \uB2E8\uB828\uD558\uC138\uC694"
    - "\uD575\uC73C\uB85C\uBD80\uD130 \uC0B4\uC544\uB0A8\uC744\uC9C0\uB3C4?"
  - strs:
    - "\uC0CC\uB4DC\uBC31\uC744 \uD1B5\uD574 \uB2E8\uB828\uD558\uC138\uC694"
    - "\uD575\uC73C\uB85C\uBD80\uD130 \uC0B4\uC544\uB0A8\uC744\uC9C0\uB3C4?"
