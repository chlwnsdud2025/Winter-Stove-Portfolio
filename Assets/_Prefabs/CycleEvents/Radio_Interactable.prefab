  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CycleEvent_Radio
  data: {fileID: 11400000, guid: 220a7d00a1b583240b91a89a29c108ca, type: 2}
  subtitles:
  - strs:
    - "\uC548\uB155\uD558\uC138\uC694, \uC5EC\uB7EC\uBD84!"
    - "\uC800\uB294 \uD790\uB9C1 \uC608\uB2A5 [\uC708\uD130 \uC2A4\uD1A0\uBE0C]\uC758
      \uBA54\uC778 MC"
    - "\uD074\uB85C\uBC84\uC785\uB2C8\uB2E4."
    - "\uC624\uB298 \uC774\uC57C\uAE30\uD560 \uC8FC\uC81C\uB294 \uBC14\uB85C,"
    - "[10\uBD84 \uB4A4\uC5D0 \uD575\uC774 \uB5A8\uC5B4\uC9C0\uBA74 \uC5B4\uCA4C\uC9C0?]
      \uC785\uB2C8\uB2E4"
    - "\uC9C4\uC9DC \uC5B4\uB5A1\uD558\uC8E0?"
  - strs:
    - "\uC74C..."
    - "\uC800\uB77C\uBA74 \uC870\uAE08\uC774\uB77C\uB3C4 \uB180\uB2E4\uAC00 \uC8FD\uACE0
      \uC2F6\uAD70\uC694"
    - "(\uCE58\uC9C0\uC9C1...)"
    - "'\uC18C\uB9AC\uAC00 \uC798 \uC548\uB4E4\uB824'"
  - strs:
    - "\uCE58\uC9C0\uC9C1... \uC544\uC778\uC288\uD0C0\uC778\uC740 \uD2C0\uB838\uB2E4"
    - "\uC2E0\uC740 \uC8FC\uC0AC\uC704 \uB180\uC774\uB97C \uC88B\uC544\uD55C\uB2E4"
    - "\uB2E4\uD2B8\uC640 \uC820\uAC00\uB3C4 \uC990\uACA8 \uD55C\uB2E4"
  allSubtitlesPlayed: {fileID: 11400000, guid: 97fcce524defca548b7267e1a54bb77e, type: 2}
  subtitlePlayer: {fileID: 0}
  subtitleTerm: 2.5
